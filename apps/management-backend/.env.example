NODE_ENV="development"
STAGE="local"
PORT=3002

DATABASE_HOST="localhost"
DATABASE_PORT=5435
DATABASE_USER="postgres"
DATABASE_PASSWORD="postgres"
DATABASE_DATABASE="postgres"

KUBE_CONFIG_PATH="/path/to/your/kubeconfig"
KUBE_BEARER_TOKEN="abcdef1234567890"
ARGO_BASE_URL="http://10.131.64.56/argo/api/v1"

# Generate randomly with `openssl rand -hex 32`
JWT_SECRET="your_jwt_secret_key"

# Default Admin User if no users exist
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adminpassword"

# Feature Flags
ORCHESTRATOR_SYNC_ENABLED="true"