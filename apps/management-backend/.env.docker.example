         NODE_ENV="production"
         STAGE="local"
         PORT=3002

         DATABASE_HOST="biomed-db"
         DATABASE_PORT=5435
         DATABASE_USER="postgres"
         DATABASE_PASSWORD="postgres"
         DATABASE_DATABASE="postgres"

         KUBE_BEARER_TOKEN="Bearer token_goes_here"
