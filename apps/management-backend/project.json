{
	"name": "management-backend",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/management-backend/src",
	"projectType": "application",
	"targets": {
		"build": {
			"executor": "@nx/vite:build",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "dist/apps/management-backend",
				"configFile": "apps/management-backend/vite.config.mts"
			},
			"configurations": {
				"development": {
					"mode": "development"
				},
				"production": {
					"mode": "production"
				}
			}
		},
		"serve": {
			"executor": "@nx/vite:dev-server",
			"defaultConfiguration": "development",
			"options": {
				"buildTarget": "management-backend:build"
			},
			"configurations": {
				"development": {
					"buildTarget": "management-backend:build:development",
					"hmr": true
				},
				"production": {
					"buildTarget": "management-backend:build:production",
					"hmr": false
				}
			}
		},
		"prune-lockfile": {
			"dependsOn": ["build"],
			"cache": true,
			"executor": "@nx/js:prune-lockfile",
			"outputs": [
				"{workspaceRoot}/dist/apps/management-backend/package.json",
				"{workspaceRoot}/dist/apps/management-backend/package-lock.json"
			],
			"options": {
				"buildTarget": "build"
			}
		},
		"copy-workspace-modules": {
			"dependsOn": ["build"],
			"cache": true,
			"outputs": ["{workspaceRoot}/dist/apps/management-backend/workspace_modules"],
			"executor": "@nx/js:copy-workspace-modules",
			"options": {
				"buildTarget": "build"
			}
		},
		"prune": {
			"dependsOn": ["prune-lockfile", "copy-workspace-modules"],
			"executor": "nx:noop"
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run"
			}
		},
		"test:coverage": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --coverage"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check"
			}
		},
		"lint:fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write"
			}
		},
		"migrations": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"configurations": {
				"run": {
					"command": "npx typeorm -d dist/apps/management-backend/migrations.main.js migration:run"
				},
				"generate": {
					"command": "npx typeorm -d dist/apps/management-backend/migrations.main.js migration:generate apps/management-backend/src/app/migrations/{args.name}"
				},
				"revert": {
					"command": "npx typeorm -d dist/apps/management-backend/migrations.main.js migration:revert"
				}
			}
		}
	},
	"tags": []
}
