{
	"name": "management-backend",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/management-backend/src",
	"projectType": "application",
	"targets": {
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "webpack-cli build --config webpack.config.js",
				"args": ["--node-env=production"],
				"cwd": "apps/management-backend"
			},
			"configurations": {
				"development": {
					"args": ["--node-env=development"]
				}
			}
		},
		"prune-lockfile": {
			"dependsOn": ["build"],
			"cache": true,
			"executor": "@nx/js:prune-lockfile",
			"outputs": [
				"{workspaceRoot}/dist/apps/management-backend/package.json",
				"{workspaceRoot}/dist/apps/management-backend/package-lock.json"
			],
			"options": {
				"buildTarget": "build"
			}
		},
		"copy-workspace-modules": {
			"dependsOn": ["build"],
			"cache": true,
			"outputs": ["{workspaceRoot}/dist/apps/management-backend/workspace_modules"],
			"executor": "@nx/js:copy-workspace-modules",
			"options": {
				"buildTarget": "build"
			}
		},
		"prune": {
			"dependsOn": ["prune-lockfile", "copy-workspace-modules"],
			"executor": "nx:noop"
		},
		"serve": {
			"continuous": true,
			"executor": "@nx/js:node",
			"defaultConfiguration": "development",
			"dependsOn": ["build"],
			"options": {
				"buildTarget": "management-backend:build",
				"runBuildTargetDependencies": false
			},
			"configurations": {
				"development": {
					"buildTarget": "management-backend:build:development"
				},
				"production": {
					"buildTarget": "management-backend:build:production"
				}
			}
		},
		"test": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run"
			}
		},
		"test:coverage": {
			"executor": "nx:run-commands",
			"options": {
				"command": "vitest run --coverage"
			}
		},
		"lint": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check"
			}
		},
		"lint:fix": {
			"executor": "nx:run-commands",
			"options": {
				"command": "biome check --write"
			}
		},
		"migrations": {
			"executor": "nx:run-commands",
			"dependsOn": ["build"],
			"configurations": {
				"run": {
					"command": "npx typeorm-ts-node-esm -d dist/apps/management-backend/migrations.main.js migration:run"
				},
				"generate": {
					"command": "npx typeorm-ts-node-esm -d dist/apps/management-backend/migrations.main.js migration:generate apps/management-backend/src/app/migrations/{args.name}"
				},
				"revert": {
					"command": "npx typeorm-ts-node-esm -d dist/apps/management-backend/migrations.main.js migration:revert"
				}
			}
		}
	},
	"tags": []
}
