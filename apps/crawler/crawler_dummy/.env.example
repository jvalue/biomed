# Local development environment for crawler_dummy
# In Kubernetes, inject these values via Secrets/Env vars instead.

MANAGEMENT_BACKEND_URL=http://localhost:3002
MANAGEMENT_API_KEY=replace-me-with-api-key
CRAWLER_DUMMY_RUN_NAMESPACE=default
CRAWLER_DUMMY_RUN_NAME=crawler-dummy
# Optional override; by default endpoint is built from namespace/name:
# /api/v1/crawler-runs/{namespace}/{name}/events
# CRAWLER_DUMMY_ENDPOINT=/api/v1/crawler-runs/default/crawler-dummy/events
