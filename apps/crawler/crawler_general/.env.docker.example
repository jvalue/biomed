FTP_URL=ftp.example.com

# Leave these as is for FTP access with anonymous login (public data)
FTP_USER=anonymous
FTP_PASSWORD=anonymous
FTP_STRUCTURE_FILE=ftp_structure.txt
FTP_MAX_DEPTH=3

# PostgreSQL Database Configuration
DB_HOST=biomed-crawler-db
DB_PORT=5436
DB_NAME=biomed-crawler-db
DB_USER=postgres
DB_PASSWORD=postgres

# RabbitMQ queue configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE=download-urls