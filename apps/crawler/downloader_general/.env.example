# RabbitMQ consumer configuration for downloader_general
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE=download-urls

# Optional tuning
DOWNLOAD_DESTINATION_DIR=/tmp/downloader-general
DOWNLOAD_TIMEOUT_SECONDS=30

# PostgreSQL Database Configuration (used to mark entries downloaded)
# Adjust to point to your crawler DB instance
DB_HOST=localhost
DB_PORT=5436
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres

# Debug mode: for large files, upload a dummy marker text file to S3 instead
DOWNLOAD_DEBUG_LARGE_FILE_MODE=false
DOWNLOAD_DEBUG_LARGE_FILE_THRESHOLD_MB=100
# Debug mode: download at most this many files per folder before skipping the rest
DOWNLOAD_DEBUG_MAX_FILES_PER_FOLDER=0
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=biomed-data
S3_UPLOAD_PREFIX=downloader-files
S3_DEBUG_PREFIX=downloader-debug
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
